# Backend runtime mode
NODE_ENV=development

# API server port
PORT=5000


# PostgreSQL connection string used by Prisma
# Example: postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public
DATABASE_URL=postgresql://your_user:your_password@localhost:5432/rental_db?schema=public

# JWT signing secret for auth tokens (use a long random string in production)
JWT_SECRET=replace_with_a_strong_random_secret

# Comma-separated frontend origin(s) allowed by CORS
# Dev example: http://localhost:5173
# Prod example: https://your-frontend-domain.com,https://www.your-frontend-domain.com
FRONTEND_URL=http://localhost:5173

# Cloudinary credentials for image uploads
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
